{
  "name": "@gimped/workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "ready": "vp check && vp run -r test && vp run -r build",
    "test": "vp run -r test",
    "build": "vp run -r build",
